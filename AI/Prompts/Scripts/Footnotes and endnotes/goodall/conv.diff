+# ---------------------------------------------------------------- raised glyphs (D31c, 15 Oct 2026)
+# Brill's books set note numbers in the body with the font's own superior digits: same nominal size, same baseline, no
+# superscript flag, so PyMuPDF shows them as ordinary digits ("Guhyasūtra 8:2"). The embedded CFF fonts keep the outlines:
+# a digit whose outline sits well above the baseline is a superior; one that hangs below is an inferior (V₁, V₂) and is left alone.
+_RAISED = {}
+NOREF = []   # (pdf page, note number) of notes with no reference found (D31c report)
+
+
+def raised_glyphs(doc):
+    """{(font name without subset prefix, glyph id): True} for raised digit-sized glyphs in the embedded CFF fonts."""
+    if doc.name in _RAISED: return _RAISED[doc.name]
+    out = {}
+    try:
+        import io
+        from fontTools.cffLib import CFFFontSet
+        seen = set()
+        for i in range(len(doc)):
+            for f in doc.get_page_fonts(i):
+                xref, ext, ftype, basefont = f[0], f[1], f[2], f[3]
+                if xref in seen or ext != 'cid': continue
+                seen.add(xref)
+                try:
+                    buf = doc.extract_font(xref)[3]
+                    cff = CFFFontSet(); cff.decompile(io.BytesIO(buf), None)
+                    top = cff[cff.fontNames[0]]; gs = top.CharStrings
+                    fm = getattr(top, 'FontMatrix', None) or [0.001]
+                    em = 1 / fm[0] if fm[0] else 1000
+                    name = basefont.split('+')[-1]
+                    for gname in gs.keys():
+                        m = re.fullmatch(r'cid0*(\d+)', gname)
+                        if not m: continue
+                        try: b = gs[gname].calcBounds(gs)
+                        except Exception: continue
+                        if not b: continue
+                        x0, y0, x1, y1 = b
+                        if y0 > 0.2 * em and y1 < 0.78 * em and (y1 - y0) < 0.55 * em: out[(name, int(m.group(1)))] = True
+                except Exception as e:
+                    print('raised_glyphs', basefont, e, file=sys.stderr)
+    except Exception as e:
+        print('raised_glyphs', e, file=sys.stderr)
+    _RAISED[doc.name] = out
+    return out
+
+
+def raised_positions(page, table):
+    """Origins (rounded) of the characters on this page drawn with a raised glyph: digits and note symbols only."""
+    pos = set()
+    if not table: return pos
+    try:
+        for sp in page.get_texttrace():
+            fname = sp['font'].split('+')[-1]
+            for c in sp['chars']:
+                if (fname, c[1]) in table and chr(c[0]).isdigit():   # digits only: the font's asterisk and daggers are raised by design
+                    pos.add((round(c[2][0], 1), round(c[2][1], 1)))
+    except Exception as e:
+        print('raised_positions', e, file=sys.stderr)
+    return pos
+
+
+def split_raised(spans, pos):
+    """Split rawdict spans so that a run of raised characters becomes a span of its own, flagged is_sup."""
+    out = []
+    for s in spans:
+        chars = s.get('chars')
+        if not chars or not pos: out.append(s); continue
+        flags_ = [ch['c'].isdigit() and (round(ch['origin'][0], 1), round(ch['origin'][1], 1)) in pos for ch in chars]   # digits only (a zero-width glyph may share the origin)
+        if not any(flags_): out.append(s); continue
+        runs = []
+        for ch, fl_ in zip(chars, flags_):
+            if runs and runs[-1][0] == fl_: runs[-1][1].append(ch)
+            else: runs.append((fl_, [ch]))
+        for fl_, g in runs:
+            gb = (min(c['bbox'][0] for c in g), min(c['bbox'][1] for c in g), max(c['bbox'][2] for c in g), max(c['bbox'][3] for c in g))
+            out.append(dict(s, chars=g, bbox=gb, is_sup=fl_))
+    return out
+
